# apps/web 環境変数の宣言的テンプレート（12-Factor III）。
# 実際の値はコミットしない（.gitignore で .env / .env.* を除外、本ファイルのみ許可）。
# 本番の実シークレットは Vercel の Environment Variables で注入する。
#
# キーを追加したら、ここにも名前とダミー値・用途を必ず追記すること。

# セッション Cookie の署名鍵。32文字以上。
# 未設定だとログインが例外で落ちる（開発用の既定値を埋め込むと、そのまま本番に出たときに
# 誰でも署名を偽造できるため、あえて既定値を持たせていない）。
# ここは値を空のままにする。他の変数と違い、それらしい長さのダミー値を書くと
# 自分の長さチェック（32文字以上）を通ってしまい、そのままコピーして使われても
# 一見動いてしまう。動いてしまう分だけ気付かれずに残る危険が大きいので空にする。
# 生成例: openssl rand -base64 48
AUTH_SECRET=

# デモ用アカウント。デモの間だけ使う仮の認証で、本番では Supabase Auth に置き換える。
# 自己登録の画面は用意しない（無関係の人が入れてしまうため）。
# パスワードも AUTH_SECRET と同じ理由で値を空にする。
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=

# データの保存先（Supabase）。lib/db/ 配下がここに接続する。
# SUPABASE_SERVICE_ROLE_KEY は Supabase プロジェクトの全データへの読み書き権限を持つ。
# AUTH_SECRET と同じ理由でここは空のままにする。
#
# ローカル開発: リポジトリルートで `pnpm exec supabase start` を実行すると
# ローカルの Supabase（Docker）が立ち上がり、API URL と service_role キーが
# 表示される（`pnpm exec supabase status` でも確認できる）。これは世界中どこでも
# 同じ固定値のローカル開発用デモ鍵で、ローカルの使い捨て Docker コンテナ以外の
# 何にも通用しない。表示された値を、このファイルではなく .env（.gitignore 対象）に貼る。
#
# 本番: Supabase ダッシュボードの Project Settings > API Keys からコピーし、
# Vercel の環境変数画面に直接貼る（生成コマンドは無い。プロジェクト作成時に発行される）。
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
