# apps/web 環境変数の宣言的テンプレート（12-Factor III）。
# 実際の値はコミットしない（.gitignore で .env / .env.* を除外、本ファイルのみ許可）。
# 本番の実シークレットは Vercel の Environment Variables で注入する。
#
# キーを追加したら、ここにも名前とダミー値・用途を必ず追記すること。

# セッション Cookie の署名鍵。32文字以上。
# 未設定だとログインが例外で落ちる（開発用の既定値を埋め込むと、そのまま本番に出たときに
# 誰でも署名を偽造できるため、あえて既定値を持たせていない）。
# 生成例: openssl rand -base64 48
AUTH_SECRET=dummy-change-me-to-a-random-string-of-32-or-more-characters

# デモ用アカウント。デモの間だけ使う仮の認証で、本番では Supabase Auth に置き換える。
# 自己登録の画面は用意しない（無関係の人が入れてしまうため）。
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=dummy-password-set-a-real-one-in-vercel
